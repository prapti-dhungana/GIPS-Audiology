<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="audiologymodel" nsURI="platform:/resource/audiologymodel/model/audiologymodel.ecore"
    nsPrefix="audiologymodel">
  <eClassifiers xsi:type="ecore:EEnum" name="Days">
    <eLiterals name="MONDAY"/>
    <eLiterals name="TUESDAY" value="1"/>
    <eLiterals name="WEDNESDAY" value="2"/>
    <eLiterals name="THURSDAY" value="3"/>
    <eLiterals name="FRIDAY" value="4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="RoomType">
    <eLiterals name="ROOM"/>
    <eLiterals name="BOOTH" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AudiologyBooking">
    <eStructuralFeatures xsi:type="ecore:EReference" name="waitingList" upperBound="-1"
        eType="#//AppointmentRequest" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="staff" upperBound="-1"
        eType="#//StaffMember" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms" upperBound="-1"
        eType="#//Room" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="days" upperBound="-1" eType="#//PlanningDay"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="timeslots" upperBound="-1"
        eType="#//Timeslot" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appointmentAssignments"
        upperBound="-1" eType="#//AppointmentAssignment" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="weeks" upperBound="-1"
        eType="#//PlanningWeek" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AppointmentRequest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomRequirement" eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="staffBandRequirement" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="appointmentType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durationSlots" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="artsFlag" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bookFromDayIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idealDayIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="StaffMember">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="band" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weeklyHours" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="artsFlag" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workingDays" upperBound="-1"
        eType="#//PlanningDay"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableFromSlot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableToSlot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType" eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="openDays" upperBound="-1"
        eType="#//PlanningDay"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableFromSlot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableToSlot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlanningDay">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dayIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dayOfWeek" eType="#//Days"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="week" eType="#//PlanningWeek"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlanningWeek">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weekIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Timeslot">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startIndex" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AppointmentAssignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="startSlot" eType="#//Timeslot"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="staffMember" eType="#//StaffMember"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="room" eType="#//Room"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="planningDay" eType="#//PlanningDay"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="request" eType="#//AppointmentRequest"/>
  </eClassifiers>
</ecore:EPackage>
